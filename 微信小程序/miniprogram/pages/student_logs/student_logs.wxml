<!--pages/student_log/student_log.wxml-->
<image class="black-and-white position_2" src="/images/4.png" alt="2" mode="aspectFill" ></image>
<text class="text_2">学生登录</text>
<!--登录表单-->
<view class="container">
  <view class="form-item">
    <text class="label">手机：</text>
    <input class="input" placeholder="请输入手机号" bindinput="onUsernameInput" />
  </view>
  <view class="form-item">
    <text class="label">密码：</text>
    <input class="input" type="password" placeholder="请输入密码" bindinput="onPasswordInput" />
  </view>
  <button class="login-button" bindtap="onLogin">登录</button>
</view>
<text class="text_3" bindtap="onRegister">注册账号</text>
<text class="text_4">忘记密码？</text>
